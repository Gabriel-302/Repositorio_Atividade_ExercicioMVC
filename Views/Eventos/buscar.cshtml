@using ExercicioMVC.ViewModels

@model BuscaEventoViewModel
@{
    ViewData["Title"] = "Cadastrar novo Evento";
}

<h1>Buscar evento</h1>
<form asp-action="Buscar" method="post">
    <input asp-for="NomeBusca" placeholder="Evento..." />
    <input asp-for="LocalBusca" placeholder="Local..." />
    <input asp-for="DataEventoBusca" type="date" class="text-danger" placeholder="Data do Evento..." />
    <button type="submit">Buscar</button>
</form>

@if(Model.Resultados.Any())
{
    <table>
    <tr>
        <th>Nome</th>
        <th>Descricao</th>
        <th>Local</th>
        <th>Data do Evento</th>
        <th>Quantidade de Vagas</th>
        <th>Valor do Ingresso</th>
    </tr>
    @foreach (Evento a in Model.Resultados)
    {
        <tr>
            <td>@a.Nome</td>
            <td>@a.Descricao</td>
            <td>@a.Local</td>
            <td>@a.DataEvento</td>
            <td>@a.QuantidadeVagas</td>
            <td>@a.ValorIngresso</td>
        </tr>
    }
</table>
}